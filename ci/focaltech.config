# Switch the touch driver from ft8756_spi to focaltech_touch
# (the unified FocalTech driver the stock MIUI kernel uses).
# The MIUI kernel (4.14.190, V14.0.3.0.SJZMIXM) enables
# CONFIG_TOUCHSCREEN_FTS=y with FTS_DIRECTORY="focaltech_touch";
# LineageOS uses CONFIG_TOUCHSCREEN_FTS_SPI=y (ft8756_spi).
# Both drivers re-flash firmware on boot (FTS_AUTO_UPGRADE_EN=1)
# and both gate the probe reset on !FTS_CHIP_IDC, so this is a
# test of whether the MIUI driver's probe/resume sequence handles
# the replacement panel better. The DT compatible is switched by
# ci/focaltech-touch-dt.patch ("focaltech,fts" -> "focaltech,fts_ts").
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"
# CONFIG_TOUCHSCREEN_FTS_SPI is not set
