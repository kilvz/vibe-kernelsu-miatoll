# KernelSU-Next fragment for the miatoll (4.14) kernel.
# Merged with scripts/kconfig/merge_config.sh after the stock
# miatoll_defconfig. KPROBES is OFF in the stock kernel and is
# required for the KernelSU kprobe hook path on 4.14.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KRETPROBES=y
CONFIG_KSU=y
