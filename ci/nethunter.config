# Kernel configurations for Kali NetHunter support (defconfig-only edition)
# for the kernelsu droidspaces branch and the vibe-kernel full branch.
#
# DIFFERENCE vs the vibe-kernel-miatoll nethunter.config: this fragment
# enables ONLY drivers that already exist in the LineageOS 4.14 tree.
# NO source patches are applied (no mac80211 injection patch, no qcacld
# injection patch, no rtl88xxau/rtw88 driver sources). That is deliberate:
# the source-patched NetHunter builds do not boot on this phone, while
# the defconfig-only approach (as in r3n3o's tested joyeuse kernel) does.
#
# ATH9K_HTC is DELIBERATELY EXCLUDED (2026-11-17): its htc_start /
# htc_stop / htc_connect_service symbols duplicate the ones in the
# phone's built-in qca-wifi-host-cmn driver (drivers/staging/
# qca-wifi-host-cmn/htc/), so the link fails with "duplicate symbol".
# Atheros AR9271 USB adapters are therefore NOT supported; the other
# three USB Wi-Fi drivers below still work.
#
# What this enables:
# - HID / DuckHunter: USB HID gadget (configfs) + HID core so the
#   phone can act as a USB keyboard/mouse (BadUSB/DuckHunter).
# - BadUSB networking: RNDIS gadget function.
# - Wi-Fi monitor mode: mac80211 framework + in-tree USB adapter
#   drivers (rtl8xxxu, rt2800usb, rtl8187) which support monitor
#   mode natively. Internal Wi-Fi injection is NOT included
#   (needs the qcacld patch) and RTL8812AU/RTL8822BU adapters are NOT
#   included (their drivers need the rtl88xxau/rtw88 sources).
# - Bluetooth Arsenal: RFCOMM / HIDP / BNEP / HCI UART.
# - CARsenal: CAN bus (raw + vcan + GS-USB adapters).
# - SDR: RTL-SDR dongles via dvb-usb-rtl28xxu.
# - USB serial adapters (CH341 / CP210x / FTDI) for console work.
#
# Merged at build time with scripts/kconfig/merge_config.sh after the
# stock vendor/xiaomi/miatoll_defconfig AND ci/droidspaces.config.
# All drivers are built IN (=y), so the AnyKernel3 zip stays
# kernel-only -- no .ko files to ship.

# HID core (USB HID devices + HID gadget support)
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y

# USB gadget: RNDIS networking function (BadUSB)
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_ETH=y

# Wireless: mac80211 framework + WLAN submenu
CONFIG_MAC80211=y
CONFIG_WLAN=y

# USB Wi-Fi adapters (monitor mode capable, in-tree drivers only)
CONFIG_RTL8XXXU=y
CONFIG_RT2800USB=y
CONFIG_RTL8187=y

# Bluetooth Arsenal
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y

# CARsenal: CAN bus
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_GS_USB=y

# SDR: RTL-SDR dongles
CONFIG_DVB_USB=y
CONFIG_DVB_USB_RTL28XXU=y

# USB serial adapters
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
# Parent options required by the drivers above (olddefconfig does not
# enable a driver whose parent menu is off):
CONFIG_RT2X00=y
CONFIG_DVB_CORE=y
CONFIG_DVB_USB_V2=y
CONFIG_I2C_MUX=y
